# ============================================================================
# DenseLite Core Configuration (Local Environment / GitHub Template)
# ============================================================================
DENSELITE_VERSION="4.0.0"

# DenseLite Cloud Provider Fallback Keys (Placeholders)
# OPENROUTER_API_KEY_1=""
# NOVITA_API_KEY_1=""
# MISTRAL_API_KEY_1=""
# COHERE_API_KEY_1=""
# COHERE_API_KEY_2=""
# HUGGINGFACE_API_KEY_1=""
# GROQ_API_KEY_1=""
# GROQ_API_KEY_2=""
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""

# Local Models Configuration (Filenames & Download URLs)
# DenseLite will dynamically load these from its internal models/ directory.

# Zero-Shot Intent Router (MoritzLaurer/ModernBERT-large-zeroshot-v2.0)
MODEL_ROUTER_FILE="modernbert/model.onnx"
MODEL_ROUTER_URL="https://huggingface.co/MoritzLaurer/ModernBERT-large-zeroshot-v2.0/resolve/main/onnx/model_int8.onnx"

# SmolLM2 (Context Compression / Fast Fallback)
MODEL_SMOLLM2_FILE="SmolLM2-360M-Instruct-Q8_0.gguf"
MODEL_SMOLLM2_URL="https://huggingface.co/HuggingFaceTB/SmolLM2-360M-Instruct-GGUF/resolve/main/smollm2-360m-instruct-q8_0.gguf"

# Nomic Embed (Vector Embeddings)
MODEL_NOMIC_FILE="nomic-embed-text-v1.5.Q8_0.gguf"
MODEL_NOMIC_URL="https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.Q8_0.gguf"

# Main Orchestrator (General & Reasoning: Llama 3.2 1B Abliterated Q4_0)
MODEL_MAIN_FILE="Llama-3.2-1B-Instruct-abliterated.i1-Q4_0.gguf"
MODEL_MAIN_URL="https://huggingface.co/mradermacher/Llama-3.2-1B-Instruct-abliterated-i1-GGUF/resolve/main/Llama-3.2-1B-Instruct-abliterated.i1-Q4_0.gguf"

# Coding Specialist (DeepSeek-R1 Distill Qwen 1.5B Q4_0)
MODEL_CODER_FILE="DeepSeek-R1-Distill-Qwen-1.5B-Q4_0.gguf"
MODEL_CODER_URL="https://huggingface.co/unsloth/DeepSeek-R1-Distill-Qwen-1.5B-GGUF/resolve/main/DeepSeek-R1-Distill-Qwen-1.5B-Q4_0.gguf"

# Whisper (Speech to Text Engine)
MODEL_WHISPER_FILE="whisper/ggml-base.en.bin"
MODEL_WHISPER_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin"

# Stable Diffusion 1.5 (Image Generation Engine)
MODEL_SD15_FILE="sd15/stable-diffusion-v1-5-pruned-emaonly-Q8_0.gguf"
MODEL_SD15_URL="https://huggingface.co/second-state/stable-diffusion-v1-5-GGUF/resolve/main/stable-diffusion-v1-5-pruned-emaonly-Q8_0.gguf"
