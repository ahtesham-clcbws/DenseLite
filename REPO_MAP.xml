struct APIKeyStatus {
    std::string provider;
    int key_index;
    std::string env_var_name; // e.g., "GROQ_API_KEY_1"
    std::string key_value;    // The actual key (loaded from RAM, NOT saved in DB)
    long long cooldown_until; // Unix timestamp
};
class SQLiteRouter {
private:
