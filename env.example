# ============================================================================
# DenseLite Core Configuration (Local Environment / GitHub Template)
# ============================================================================
DENSELITE_VERSION="3.0"

# DenseLite Cloud Provider Fallback Keys (Placeholders)
# OPENROUTER_API_KEY_1=""
# NOVITA_API_KEY_1=""
# MISTRAL_API_KEY_1=""
# COHERE_API_KEY_1=""
# COHERE_API_KEY_2=""
# HUGGINGFACE_API_KEY_1=""
# GROQ_API_KEY_1=""
# GROQ_API_KEY_2=""
# GEMINI_API_KEY_1=""
# GEMINI_API_KEY_2=""

# Local Models Configuration (Filenames & Download URLs)
# DenseLite will dynamically load these from its internal models/ directory.

# Needle (Semantic Intent Router)
MODEL_NEEDLE_FILE="needle3/needle3.cact"
MODEL_NEEDLE_URL="https://huggingface.co/DenseLite/needle3/resolve/main/needle3.cact"

# SmolLM2 (Context Compression / Fast Fallback)
MODEL_SMOLLM2_FILE="SmolLM2-360M-Instruct-Q8_0.gguf"
MODEL_SMOLLM2_URL="https://huggingface.co/HuggingFaceTB/SmolLM2-360M-Instruct-GGUF/resolve/main/smollm2-360m-instruct-q8_0.gguf"

# Nomic Embed (Vector Embeddings)
MODEL_NOMIC_FILE="nomic-embed-text-v1.5.Q8_0.gguf"
MODEL_NOMIC_URL="https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.Q8_0.gguf"

# Qwen 2.5 1.5B (Main Local Brain)
MODEL_QWEN_MAIN_FILE="Qwen2.5-1.5B-Instruct-abliterated.Q8_0.gguf"
MODEL_QWEN_MAIN_URL="https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q8_0.gguf"

# Qwen 2.5 Coder 1.5B (Code Execution/Parsing)
MODEL_QWEN_CODER_FILE="Qwen2.5-Coder-1.5B-Instruct-abliterated-Q8_0.gguf"
MODEL_QWEN_CODER_URL="https://huggingface.co/Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF/resolve/main/qwen2.5-coder-1.5b-instruct-q8_0.gguf"

# Whisper (Speech to Text Engine)
MODEL_WHISPER_FILE="whisper/ggml-base.en.bin"
MODEL_WHISPER_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin"

# Stable Diffusion 1.5 (Image Generation Engine)
MODEL_SD15_FILE="sd15/v1-5-pruned-emaonly.safetensors"
MODEL_SD15_URL="https://huggingface.co/runwayml/stable-diffusion-v1-5/resolve/main/v1-5-pruned-emaonly.safetensors"
