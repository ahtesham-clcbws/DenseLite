DENSELITE_VERSION="3.3.0"

# DenseLite Cloud Provider Fallback Keys (Placeholders)
# OPENROUTER_API_KEY_1=""
# NOVITA_API_KEY_1=""
# MISTRAL_API_KEY_1=""
# COHERE_API_KEY_1=""
# COHERE_API_KEY_2=""
