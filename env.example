# GEMINI_API_KEY_2=""

# Local Models Configuration (Client-Facing Models in ~/.denselite/models/)
# DenseLite automatically checks and downloads these if missing.

# Main Orchestrator (General & Reasoning: Llama 3.2 1B Abliterated Q4_K_M)
MODEL_MAIN_FILE="Llama-3.2-1B-Instruct-abliterated.i1-Q4_K_M.gguf"
MODEL_MAIN_URL="https://huggingface.co/mradermacher/Llama-3.2-1B-Instruct-abliterated-i1-GGUF/resolve/main/Llama-3.2-1B-Instruct-abliterated.i1-Q4_K_M.gguf"

# Coding Specialist (DeepSeek-R1 Distill Qwen 1.5B Q4_K_M)
MODEL_CODER_FILE="DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf"
MODEL_CODER_URL="https://huggingface.co/unsloth/DeepSeek-R1-Distill-Qwen-1.5B-GGUF/resolve/main/DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf"

# Context Compressor & Slicer (SmolLM2 360M Instruct Q4_K_M)
MODEL_SMOLLM2_FILE="smollm2-360m-instruct-q4_k_m.gguf"
MODEL_SMOLLM2_URL="https://huggingface.co/mfuntowicz/SmolLM2-360M-Instruct-Q4_K_M-GGUF/resolve/main/smollm2-360m-instruct-q4_k_m.gguf"

# Semantic Vector Memory (Nomic Embed Text v2 MoE Q4_K_M)
MODEL_NOMIC_FILE="nomic-embed-text-v2-moe.Q4_K_M.gguf"
MODEL_NOMIC_URL="https://huggingface.co/nomic-ai/nomic-embed-text-v2-moe-GGUF/resolve/main/nomic-embed-text-v2-moe.Q4_K_M.gguf"

# Speech-to-Text Audio Engine (Whisper Large V3 Turbo Q4_0)
MODEL_WHISPER_FILE="whisper/whisper-large-v3-turbo-q4_0.gguf"
MODEL_WHISPER_URL="https://huggingface.co/oxide-lab/whisper-large-v3-turbo-GGUF/resolve/main/whisper-large-v3-turbo-q4_0.gguf"

# Vision / Image Generation Engine (SDXL Lightning 4-step Q4_0)
MODEL_VISION_FILE="vision/sdxl_lightning_4step.q4_0.gguf"
MODEL_VISION_URL="https://huggingface.co/mzwing/SDXL-Lightning-GGUF/resolve/main/sdxl_lightning_4step.q4_0.gguf"
