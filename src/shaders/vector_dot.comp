#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer InA {
    float a[];
};
layout(std430, binding = 1) readonly buffer InB {
    float b[];
};
layout(std430, binding = 2) writeonly buffer OutRes {
    float result[];
};

layout(push_constant) uniform PushConstants {
    uint n;
} pc;

shared float shared_sum[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint i = tid; i < pc.n; i += 256) {
        sum += a[i] * b[i];
    }
    shared_sum[tid] = sum;
    barrier();

    for (uint s = 128; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        result[0] = shared_sum[0];
    }
}
